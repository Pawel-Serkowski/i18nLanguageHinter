{
    "name": "i18nlanguagehinter",
    "displayName": "i18nLanguageHinter",
    "description": "Based on the selected dictionary in the JSON file, inline hints are generated next to the keys that appear in the text. This is particularly useful when working with the i18n library.",
    "version": "1.1.0",
    "engines": {
        "vscode": "^1.107.0"
    },
    "publisher": "PawelSerkowski",
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:javascript",
        "onLanguage:javascriptreact",
        "onLanguage:typescript",
        "onLanguage:typescriptreact"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "i18n Language Hinter",
            "properties": {
                "i18nLanguageHinter.keyPattern": {
                    "type": "string",
                    "default": "id_[\\w-]+",
                    "description": "Regular expression pattern to find translation keys in document text."
                },
                "i18nLanguageHinter.hintPrefix": {
                    "type": "string",
                    "default": " :",
                    "description": "Prefix text displayed before the translation hint."
                },
                "i18nLanguageHinter.maxHintLength": {
                    "type": "number",
                    "default": 40,
                    "description": "Maximum character length of the translation text shown in the inlay hint before truncation."
                }
            }
        },
        "commands": [
            {
                "command": "i18nlanguagehinter.selectDictionaryFile",
                "title": "i18n Language Hinter: Select dictionary file"
            },
            {
                "command": "i18nlanguagehinter.changeFolderCmd",
                "title": "i18n Language Hinter: Select different dictionary folder",
                "icon": "$(folder-opened)"
            },
            {
                "command": "i18nlanguagehinter.loadLanguageCmd",
                "title": "i18n Language Hinter: load clicked language file"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "i18n-plugin-explorer",
                    "title": "i18n Language Hinter",
                    "icon": "$(library)"
                }
            ]
        },
        "views": {
            "i18n-plugin-explorer": [
                {
                    "id": "i18n-files-view",
                    "name": "Language Files",
                    "icon": "$(folder)"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "i18nlanguagehinter.changeFolderCmd",
                    "when": "view == i18n-files-view",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "1.107.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "typescript-eslint": "^8.56.1",
        "eslint": "^9.39.3",
        "typescript": "^5.9.3",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2"
    }
}